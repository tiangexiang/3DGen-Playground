# ===========================================
# 3DGS Configuration
# ===========================================
GS_PATH=/path/to/save/3dgs/files # the path should lead to unzipped GS folders, e.g. 1917,  1920,  1924...
DOWNLOAD_META=true # true or false
DOWNLOAD_AESTHETIC=true # true or false
DOWNLOAD_NON_AESTHETIC=true # true or false

# Object list JSON files from GaussianVerse
AESTHETIC_JSON=$GS_PATH/aesthetic_list.json
NON_AESTHETIC_JSON=$GS_PATH/non_aesthetic_list.json

ALL_OBJ_JSON=$GS_PATH/all_obj_list.json
# use the below variables instead if you just want to run on subsets
# ALL_OBJ_JSON=$AESTHETIC_JSON
# ALL_OBJ_JSON=$NON_AESTHETIC_JSON

# ===========================================
# Captions Configuration
# ===========================================
# Downloaded caption files
TDTOPIA_CAPTION_PATH=/path/to/3DTopia-objaverse-caption-361k.json
CAP3D_CAPTION_PATH=/path/to/Cap3D_automated_Objaverse_full.csv

# Final preprocessed captions output
CAPTIONS_PATH=/path/to/output/captions.json

# ===========================================
# 2D Renderings Configuration
# ===========================================
RENDERINGS_DIR=/path/to/save/2d/renderings

# ===========================================
# WebDataset Creation Configuration
# ===========================================
# WebDataset output directory
WEBDATASET_DIR=/path/to/output/webdataset

# ===========================================
# Data Loader Configuration
# ===========================================
# Normalization statistics files (download from GaussianVerse)
GS_MEAN_FILE=$GS_PATH/gaussianverse_mean.pt
GS_STD_FILE=$GS_PATH/gaussianverse_std.pt

# WebDataset shard pattern for fast data loading
SHARD_PATTERN="/path/to/your/shards/gaussianverse-*.tar"

# ===========================================
# Training Paths (bash train.sh reads this file)
# ===========================================
# Use the same object list for caption encoding, framing-table generation, and training.
DGEN_OBJ_LIST=$ALL_OBJ_JSON
# Keep decoded splat caches (~106 GiB), T5 tokens (~47 GB), and checkpoints
# on a disk with enough space. Relative paths below are relative to the repo root.
DGEN_ASSET_ROOT=datasets/baseline_assets
DGEN_WORK_ROOT=output
DGEN_T5_TOKEN_ROOT=$DGEN_WORK_ROOT/t5_tokens
DGEN_CACHE_ROOT=$DGEN_WORK_ROOT/cache/preload_text
DGEN_OUTPUT_ROOT=$DGEN_WORK_ROOT/runs
DGEN_WANDB_PROJECT=3dgen
# Optional: NPROC_PER_NODE=2 (otherwise train.sh uses all visible GPUs).
# Automatic accumulation preserves the default global batch of 512.
